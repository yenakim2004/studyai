{
  // StudyAI Worker. No secret belongs in this file. `pnpm local` passes STUDYAI_LOOPBACK and CHATGPT_SEAL_KEY through
  // an env file under .studyai-local/ (git-ignored). A hosted copy gets neither, so it serves the study app with no AI.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studyai",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,

  // Only the API and the OAuth callback run the Worker. The static files hold no private data: the library lives in the
  // browser, and the ChatGPT account is reachable only through the loopback-checked API (worker/src/loopback.ts).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },

  // One Durable Object (SQLite-backed) holds the ChatGPT sign-in. Its class, binding and migration tag address existing
  // local state: renaming any of them would lose the connected account.
  "durable_objects": { "bindings": [{ "name": "STUDYAI", "class_name": "StudyAiDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StudyAiDO"] }],

  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
