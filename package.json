{
  "name": "studyai",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yenakim2004/studyai.git"
  },
  "bugs": {
    "url": "https://github.com/yenakim2004/studyai/issues"
  },
  "homepage": "https://github.com/yenakim2004/studyai#readme",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.28.11",
  "description": "PPTX·PDF 강의 자료와 ChatGPT 플랜으로 공부하는 한국어 로컬 학습 도우미.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "build:sites": "tsc -b && vite build --mode sites",
    "preview:sites": "vite preview --mode sites --host 127.0.0.1 --port 4174 --strictPort",
    "test:e2e:sites": "playwright test -c playwright.sites.config.ts",
    "test:e2e:sites-server": "pnpm build:sites-server && playwright test -c playwright.sites-server.config.ts",
    "preview": "vite preview",
    "preview:demo": "vite preview --mode demo",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm build && pnpm typecheck:worker && vitest run && playwright test",
    "notices": "node scripts/third-party-notices.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "check:attribution": "node scripts/check-attribution.mjs",
    "cli:build": "vite build -c vite.cli.config.ts",
    "types:worker": "wrangler types --strict-vars=false",
    "typecheck:worker": "pnpm types:worker && tsc -p tsconfig.worker.json",
    "local": "node scripts/local.mjs",
    "worker:dev": "pnpm local",
    "db:generate": "drizzle-kit generate",
    "build:sites-server": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && pnpm cli:build && tsc -b && vite build -c vite.sites.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "fast-xml-parser": "5.12.0",
    "fflate": "0.8.3",
    "jose": "6.2.14",
    "katex": "0.19.0",
    "lucide-react": "1.54.0",
    "minisearch": "7.2.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "ts-fsrs": "5.4.2",
    "unified": "11.0.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "@cloudflare/vite-plugin": "1.37.1"
  }
}
